{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalkula",
  "version": "0.1.0",
  "identifier": "de.carvalhodasilva.kalkula",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run check"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "Kalkula", "width": 1280, "height": 780,
        "minWidth": 900, "minHeight": 520, "theme": "Dark",
        "dragDropEnabled": false }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
